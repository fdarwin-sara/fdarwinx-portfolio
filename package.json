{
  "name": "fdarwinx-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": ["apps/web", "apps/api"],
  "scripts": {
    "dev": "concurrently --kill-others --names web,api \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace @fdarwinx/web --",
    "dev:api": "npm run dev --workspace @fdarwinx/api",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces && eslint --config apps/api/eslint.config.mjs tests/e2e",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace @fdarwinx/api",
    "test:e2e": "node tests/e2e/portfolio.mjs"
  },
  "devDependencies": {
    "concurrently": "10.0.7",
    "eslint": "9.39.5",
    "playwright": "1.65.1"
  }
}
