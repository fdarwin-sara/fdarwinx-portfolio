{
  "name": "@fdarwinx/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently --kill-others --names compiler,server \"tsc --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=.env dist/main.js\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/throttler": "6.8.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
